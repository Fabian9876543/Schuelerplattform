// Schuelerplattform - Datenmodell
//
// Status- und Typfelder sind echte enum-Typen: Die Datenbank laesst dadurch
// keinen ungueltigen Wert zu, und Prisma erzeugt daraus TypeScript-Typen.
// Das Fach bleibt bewusst eine String-Spalte - die Faecherliste ist
// Inhalt, kein Code, und soll sich ohne Migration ergaenzen lassen. Die
// erlaubten Werte stehen in lib/constants.ts und werden per Zod geprueft.
// Listen (z.B. Antwortoptionen) liegen als JSON-String und werden beim Lesen
// ueber einen Zod-Parser gefuehrt, nie mit blankem JSON.parse.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Wo ein Selbsttest gerade steht.
enum AssessmentStatus {
  draft
  submitted
  evaluated
}

/// Fragetyp im Selbsttest.
enum QuestionKind {
  multiple_choice
  free_text
}

/// Woher eine Auswertung stammt: von Claude oder regelbasiert.
enum EvaluationSource {
  ai
  rule
}

/// Wie sicher ein Teilthema sitzt - die Ampel aus dem Lernplan.
enum MasteryLevel {
  weak
  medium
  strong
}

/// Was fuer ein Konto das ist.
///
/// Bewusst getrennt von der Frage, wer verwalten darf (`User.isAdmin`): Das
/// sind zwei verschiedene Dinge. Eine Lehrkraft muss nichts verwalten, und
/// eine Schuelerin darf es duerfen. Steckte beides in einer Spalte, liesse
/// sich von einem Verwalter nicht mehr sagen, ob er eine Klasse hat.
enum UserKind {
  student
  /// keine Klassenstufe; nimmt an der Nachhilfe nicht teil
  teacher
}

/// Was gemeldet wurde.
enum ReportTargetType {
  offer
  message
  rating
}

/// Warum gemeldet wurde.
enum ReportReason {
  insult
  inappropriate
  spam
  other
}

/// Stand einer Meldung.
enum ReportStatus {
  open
  resolved
  rejected
}

/// Stand eines vereinbarten Termins.
enum AppointmentStatus {
  /// vorgeschlagen, die andere Seite hat noch nicht zugesagt
  proposed
  confirmed
  cancelled
}

/// Stand einer Nachhilfe-Anfrage.
enum RequestStatus {
  open
  accepted
  declined
  withdrawn
}

/// Eine Schule. Wer ihren Beitrittscode hat, kommt in ihren Bereich.
/// Das Konzept sieht vor, dass die Plattform zunaechst innerhalb einer Schule
/// funktioniert - Suche und Anfragen enden deshalb an dieser Grenze.
model School {
  id        String   @id @default(cuid())
  name      String
  /// Code, den die Schule an ihre Schueler ausgibt
  joinCode  String   @unique
  /// Eigener Code fuer Lehrkraefte. Getrennt, weil damit ein Konto ohne
  /// Klassenstufe entsteht - wer den Schuelercode hat, soll sich nicht
  /// selbst zur Lehrkraft erklaeren koennen.
  teacherJoinCode String @unique
  /// Muessen Nachhilfe-Angebote erst freigegeben werden, bevor sie in der
  /// Suche auftauchen? Voreinstellung: nein - eine Schule, die diese Huerde
  /// nicht will, soll sie nicht aufgezwungen bekommen.
  requiresApproval Boolean @default(false)
  createdAt DateTime @default(now())

  users    User[]
  subjects SchoolSubject[]
  reports  Report[]
}

/// Ein Fach, das diese Schule zulaesst.
///
/// Solange eine Schule keinen einzigen Eintrag hat, sind alle Faecher aus
/// lib/constants.ts erlaubt. Eine leere Liste heisst also "keine
/// Einschraenkung" und nicht "nichts erlaubt" - sonst waere jede Schule
/// stillgelegt, bis jemand eine Liste pflegt.
model SchoolSubject {
  id       String @id @default(cuid())
  schoolId String
  subject  String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, subject])
  @@index([schoolId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  /// Nur Schuelerkonten haben eine Klassenstufe; bei Lehrkraeften ist sie
  /// leer. Die Datenbank haelt beides auseinander (CHECK in der Migration).
  gradeLevel   Int?
  schoolId     String
  kind         UserKind @default(student)
  /// Darf die eigene Schule verwalten. Unabhaengig davon, ob Schueler oder
  /// Lehrkraft - beides kommt vor.
  isAdmin      Boolean  @default(false)
  /// Gesperrt von der Schule: Anmeldung nicht mehr moeglich, Angebote
  /// verschwinden aus der Suche. Sperren duerfen nur Lehrkraefte mit
  /// Verwaltungsrechten - unter Mitschuelern waere das ein Machtmittel.
  blockedAt    DateTime?
  blockedById  String?
  createdAt    DateTime @default(now())

  school            School            @relation(fields: [schoolId], references: [id])
  sessions          Session[]
  learningGoals     LearningGoal[]
  tutorOffers       TutorOffer[]
  sentRequests      TutoringRequest[] @relation("RequestsSent")
  sentMessages      Message[]         @relation("MessagesSent")
  givenRatings      Rating[]          @relation("RatingsGiven")
  proposedMeetings  Appointment[]     @relation("AppointmentsProposed")
  approvedOffers    TutorOffer[]      @relation("OffersApproved")
  filedReports      Report[]          @relation("ReportsFiled")
  reportsAbout      Report[]          @relation("ReportsAbout")
  handledReports    Report[]          @relation("ReportsHandled")
  blockedBy         User?             @relation("Blocks", fields: [blockedById], references: [id], onDelete: SetNull)
  blockedAccounts   User[]            @relation("Blocks")

  @@index([schoolId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ein Lernvorhaben: "Am 12.10. Mathe-Klausur ueber Ableitungen und Kurvendiskussion"
model LearningGoal {
  id        String   @id @default(cuid())
  userId    String
  title     String
  subject   String
  examDate  DateTime
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics      Topic[]
  assessments Assessment[]

  @@index([userId])
}

/// Ein Teilthema innerhalb eines Lernvorhabens
model Topic {
  id             String @id @default(cuid())
  learningGoalId String
  name           String
  /// kleingeschrieben und normalisiert - Schluessel fuer das Tutoren-Matching
  normalized     String
  position       Int
  /// Lernstand: anfangs aus der Auswertung abgeleitet, danach vom Schueler
  /// selbst gepflegt. Steuert, welche Lernaufgaben noch noetig sind.
  mastery        MasteryLevel @default(weak)
  masteryUpdatedAt DateTime?

  learningGoal LearningGoal @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  questions    Question[]
  selfRatings  SelfRating[]
  deficits     Deficit[]
  studyTasks   StudyTask[]

  @@index([learningGoalId])
}

/// Ein Durchlauf des Selbsttests
model Assessment {
  id             String    @id @default(cuid())
  learningGoalId String
  status         AssessmentStatus @default(draft)
  createdAt      DateTime  @default(now())
  submittedAt    DateTime?

  learningGoal LearningGoal @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  questions    Question[]
  selfRatings  SelfRating[]
  evaluation   Evaluation?

  @@index([learningGoalId])
}

model Question {
  id           String @id @default(cuid())
  assessmentId String
  topicId      String?
  kind         QuestionKind
  prompt       String
  position     Int

  /// JSON-Array der Antwortmoeglichkeiten (nur bei multiple_choice)
  optionsJson  String?
  correctIndex Int?
  /// Erwartungshorizont fuer Freitextfragen - worauf es in der Antwort ankommt
  expectedPoints String?

  // Antwort und Bewertung
  answerText  String?
  answerIndex Int?
  isCorrect   Boolean?
  /// 0-100, bei Freitext von der Auswertung vergeben
  score       Int?
  feedback    String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  topic      Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([topicId])
}

/// Selbsteinschaetzung des Schuelers pro Teilthema (1 = unsicher, 5 = sicher)
model SelfRating {
  id           String @id @default(cuid())
  assessmentId String
  topicId      String
  confidence   Int

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, topicId])
  @@index([assessmentId])
}

/// Ergebnis der Auswertung eines Selbsttests
model Evaluation {
  id           String   @id @default(cuid())
  assessmentId String   @unique
  summary      String
  /// 0-100
  overallScore Int
  /// woher die Auswertung stammt
  source       EvaluationSource
  createdAt    DateTime @default(now())

  assessment Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  deficits   Deficit[]
  studyTasks StudyTask[]
}

/// Ein erkanntes Defizit - der Anknuepfungspunkt fuer die Nachhilfesuche
model Deficit {
  id           String @id @default(cuid())
  evaluationId String
  topicId      String
  /// 1 = leicht, 2 = deutlich, 3 = gravierend
  severity     Int
  explanation  String

  evaluation Evaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  topic      Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  requests   TutoringRequest[]

  @@index([evaluationId])
  @@index([topicId])
}

/// Eine Aufgabe im Lernplan, fest auf einen Kalendertag gelegt
model StudyTask {
  id               String   @id @default(cuid())
  evaluationId     String
  topicId          String?
  dueDate          DateTime
  title            String
  description      String
  estimatedMinutes Int
  done             Boolean  @default(false)
  /// Entfaellt, weil das Thema inzwischen sitzt. Bleibt erhalten statt
  /// geloescht zu werden - wackelt das Thema wieder, lebt die Aufgabe auf.
  skipped          Boolean  @default(false)

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  topic      Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([evaluationId])
}

/// "Ich gebe Nachhilfe in Mathe bis Klasse 11"
model TutorOffer {
  id            String  @id @default(cuid())
  userId        String
  subject       String
  maxGradeLevel Int
  description   String
  active        Boolean @default(true)
  /// Von der Schule freigegeben. Zaehlt nur, wenn die Schule Freigaben
  /// verlangt; sonst ist das Feld ohne Wirkung.
  approved      Boolean @default(false)
  approvedAt    DateTime?
  approvedById  String?

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("OffersApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  topics   TutorOfferTopic[]
  requests TutoringRequest[]
  ratings  Rating[]

  @@index([userId])
  @@index([subject])
}

model TutorOfferTopic {
  id           String @id @default(cuid())
  tutorOfferId String
  name         String
  /// kleingeschrieben und normalisiert - Schluessel fuer das Matching
  normalized   String

  tutorOffer TutorOffer @relation(fields: [tutorOfferId], references: [id], onDelete: Cascade)

  @@index([tutorOfferId])
}

model TutoringRequest {
  id           String @id @default(cuid())
  requesterId  String
  tutorOfferId String
  /// optional: aus welchem Defizit die Anfrage entstanden ist
  deficitId    String?
  topic        String
  message      String
  status       RequestStatus @default(open)

  responseMessage String?
  createdAt       DateTime  @default(now())
  respondedAt     DateTime?

  requester  User       @relation("RequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  tutorOffer TutorOffer @relation(fields: [tutorOfferId], references: [id], onDelete: Cascade)
  deficit    Deficit?   @relation(fields: [deficitId], references: [id], onDelete: SetNull)
  messages   Message[]
  rating     Rating?
  meetings   Appointment[]

  @@index([requesterId])
  @@index([tutorOfferId])
}

/// Eine Nachricht im Verlauf zu einer Nachhilfe-Anfrage.
///
/// Geschrieben wird in der App, nicht per E-Mail: Adressen von Minderjaehrigen
/// verlassen den Server damit gar nicht erst.
///
/// An einem Verlauf haengen genau zwei Personen, deshalb gibt es keine
/// Empfaengerspalte - Empfaenger ist, wer nicht Absender ist. `readAt` haelt
/// fest, wann die Gegenseite gelesen hat; die Zahl der neuen Nachrichten
/// ergibt sich daraus und kann nicht veralten wie ein mitgefuehrter Zaehler.
model Message {
  id        String    @id @default(cuid())
  requestId String
  senderId  String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  request TutoringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User            @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([senderId])
}

/// Die Rueckmeldung nach einer Nachhilfe: wie gut wurde erklaert?
///
/// Bewertet wird eine einzelne Anfrage, nicht eine Person - deshalb
/// `requestId @unique`. Wer zweimal Hilfe bekommen hat, gibt zwei
/// Rueckmeldungen; beide Male gab es ja auch echte Nachhilfe.
///
/// Bewerten darf nur, wer angefragt hat, und erst nach einer Zusage. Die
/// Gegenrichtung gibt es bewusst nicht: Sichtbar werden sollen gute
/// Erklaerer, nicht "gute" Hilfesuchende.
///
/// `tutorOfferId` steht doppelt (er liesse sich ueber die Anfrage finden),
/// damit sich der Schnitt je Angebot in einer Abfrage bilden laesst. Die
/// Anfrage wechselt ihr Angebot nie, der Wert kann also nicht auseinanderlaufen.
model Rating {
  id           String   @id @default(cuid())
  requestId    String   @unique
  tutorOfferId String
  raterId      String
  /// 1 bis 5; die Datenbank laesst nichts anderes zu (CHECK in der Migration)
  stars        Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  request    TutoringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tutorOffer TutorOffer      @relation(fields: [tutorOfferId], references: [id], onDelete: Cascade)
  rater      User            @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)

  @@index([tutorOfferId])
  @@index([raterId])
}

/// Ein fester Lerntermin zu einer Nachhilfe-Anfrage.
///
/// Vorgeschlagen wird von einer Seite, zugesagt von der anderen - deshalb
/// `proposedById`: Wer vorschlaegt, kann nicht selbst zusagen, sonst waere die
/// Zusage keine. Absagen duerfen beide, auch noch nach der Zusage; ein Termin
/// wird dabei nicht geloescht, sondern auf `cancelled` gesetzt, damit im
/// Verlauf nachvollziehbar bleibt, dass es ihn gab.
///
/// `startsAt` ist eine Wanduhrzeit, kein Zeitpunkt mit Zeitzone: Eingabe und
/// Anzeige laufen beide auf dem Server, dadurch kommt heraus, was eingetippt
/// wurde. Fuer eine Plattform innerhalb einer Schule ist das richtig - alle
/// Beteiligten sitzen ohnehin in derselben Zeitzone.
model Appointment {
  id              String   @id @default(cuid())
  requestId       String
  proposedById    String
  startsAt        DateTime
  /// Dauer in Minuten; die Datenbank laesst nur 15 bis 240 zu (CHECK)
  durationMinutes Int
  /// "Bibliothek", "Raum 204", "bei mir zu Hause" - freiwillig
  place           String?
  status          AppointmentStatus @default(proposed)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  respondedAt     DateTime?

  request    TutoringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposedBy User            @relation("AppointmentsProposed", fields: [proposedById], references: [id], onDelete: Cascade)

  @@index([requestId, startsAt])
  @@index([startsAt])
  @@index([proposedById])
}

/// Eine Meldung ueber einen Inhalt.
///
/// Gemeldet wird **Inhalt, keine Person**: eine Meldung ohne konkreten Anlass
/// kann niemand pruefen.
///
/// Zwei Entscheidungen stecken im Aufbau:
///
/// - `snapshot` haelt den Wortlaut zum Zeitpunkt der Meldung fest. Die
///   Verwaltung sieht damit genau den gemeldeten Ausschnitt und nicht den
///   Verlauf drumherum - "Verwalten heisst nicht mitlesen" bleibt gueltig,
///   soweit es geht.
/// - `targetId` hat bewusst **keinen Fremdschluessel**. Sonst naehme eine
///   geloeschte Nachricht die Meldung mit sich - genau das, was jemand
///   erreichen wollte, der etwas Unzulaessiges geschrieben hat.
model Report {
  id         String @id @default(cuid())
  /// Meldungen bleiben an der Schulgrenze, wie alles andere auch.
  schoolId   String
  reporterId String
  /// wer den gemeldeten Inhalt verfasst hat
  authorId   String
  targetType ReportTargetType
  targetId   String
  snapshot   String
  reason     ReportReason
  /// was die meldende Person dazuschreibt
  note       String?

  status      ReportStatus @default(open)
  handledById String?
  handledAt   DateTime?
  /// Notiz der Verwaltung beim Abschliessen
  resolution  String?
  createdAt   DateTime @default(now())

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reporter  User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  author    User   @relation("ReportsAbout", fields: [authorId], references: [id], onDelete: Cascade)
  handledBy User?  @relation("ReportsHandled", fields: [handledById], references: [id], onDelete: SetNull)

  /// Eine Meldung je Person und Inhalt - sonst laesst sich jemand mit
  /// fuenfzig Meldungen zuschuetten.
  @@unique([reporterId, targetType, targetId])
  @@index([schoolId, status])
  @@index([authorId])
}

/// Fehlgeschlagene Anmeldeversuche - bremst das Durchprobieren von Passwoertern.
/// Gezaehlt wird nach E-Mail, nicht nach IP: Schueler sitzen im selben
/// Schul-WLAN hinter einer Adresse, eine IP-Sperre traefe die ganze Klasse.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
