# Datenbank: PostgreSQL. Lokal zum Beispiel ein eigener Server,
# fuer den Betrieb eine gehostete Datenbank (Neon, Supabase, Vercel Postgres).
DATABASE_URL="postgresql://benutzer:passwort@host:5432/schuelerplattform"

# Optional: Ohne Schluessel laeuft die App vollstaendig mit der
# regelbasierten Auswertung. Mit Schluessel uebernimmt Claude
# die Fragengenerierung und die Auswertung.
#
# Zwei Namen werden akzeptiert. Lokal ist ANTHROPIC_API_KEY bequem.
# In einer Claude-Code-Cloud-Umgebung besser den eigenen Namen nehmen:
# Claude Code selbst bevorzugt ANTHROPIC_API_KEY gegenueber dem Abo, sonst
# zahlt das API-Guthaben auch die eigene Claude-Code-Nutzung.
# SCHUELERPLATTFORM_ANTHROPIC_KEY="sk-ant-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Nur fuer den Zugriff vom Handy im eigenen WLAN noetig, und auch nur dann,
# wenn die beim Start angezeigte "Network:"-Adresse ausserhalb der ueblichen
# Heimnetz-Bereiche liegt (192.168.x.x, 10.x.x.x, 172.16.x.x).
# DEV_ORIGIN="172.20.10.5"
